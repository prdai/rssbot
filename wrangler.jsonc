{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rssbot",
  "main": "src/index.ts",
  "account_id": "6503f7d355399abee9e748d3100675d4",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "FROM_EMAIL": "rss@prdai.dev",
    "TO_EMAIL": "go2ranuga@gmail.com",
  },
  "kv_namespaces": [
    {
      "binding": "FEED_STATE",
      "id": "1b43a5742b954bf3bcc5d0d817f9a92d",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "go2ranuga@gmail.com",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "placement": { "mode": "smart" },
  "upload_source_maps": true,
  "triggers": { "crons": ["0 * * * *"] },
}
